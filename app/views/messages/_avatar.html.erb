<%# Avatar SVG icons for chat bubbles. Pure inline SVG, no external deps. %>
<% case role.to_s
   when "user" %>
  <span class="message__avatar" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 12a5 5 0 1 0-5-5 5 5 0 0 0 5 5zm0 2c-3.866 0-9 1.943-9 5.5V21h18v-1.5C21 15.943 15.866 14 12 14z"/></svg>
  </span>
<% when "assistant" %>
  <span class="message__avatar" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a2 2 0 0 1 2 2v1h3a3 3 0 0 1 3 3v3a1 1 0 0 1-1 1h-1v3a4 4 0 0 1-4 4H10a4 4 0 0 1-4-4v-3H5a1 1 0 0 1-1-1V8a3 3 0 0 1 3-3h3V4a2 2 0 0 1 2-2zm-3 9a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zm6 0a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3z"/></svg>
  </span>
<% end %>
