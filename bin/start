#!/usr/bin/env ruby
LLM_API_KEYS = %w[GEMINI_API_KEY OPENAI_API_KEY].freeze

if LLM_API_KEYS.none? { |key| ENV[key].to_s.strip != "" }
  abort "Set #{LLM_API_KEYS.join(' or ')} before running bin/start."
end

puts "== Starting Postgres =="
system("docker", "compose", "up", "-d", "--wait", "db", exception: true)

exec File.expand_path("setup", __dir__), *ARGV
